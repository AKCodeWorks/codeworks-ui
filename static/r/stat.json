{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "stat",
	"title": "Stat",
	"type": "registry:ui",
	"description": "Displays related numbers and supporting data in composable horizontal, vertical, or responsive blocks.",
	"registryDependencies": [
		"utils"
	],
	"meta": {
		"docs": {
			"usage": "Compose Root, Item, Title, Value, and Description. Add Figure for an icon or image and Actions for controls. Root defaults to a horizontal layout; use vertical or responsive when the stats should stack, including on smaller screens.",
			"moreExamples": [
				{
					"name": "dashboard",
					"title": "Responsive dashboard",
					"description": "Combine figures, semantic colors, and multiple values in a layout that stacks on smaller screens."
				},
				{
					"name": "actions",
					"title": "Actions and alignment",
					"description": "Add controls or center individual stat items with ordinary Tailwind classes."
				}
			],
			"api": [
				{
					"name": "Root.direction",
					"type": "horizontal | vertical | responsive",
					"default": "horizontal"
				},
				{
					"name": "class",
					"type": "string",
					"default": "—"
				},
				{
					"name": "children",
					"type": "Snippet",
					"default": "required"
				}
			]
		}
	},
	"files": [
		{
			"content": "<script lang=\"ts\" module>\n\texport type StatDirection = 'horizontal' | 'vertical' | 'responsive';\n</script>\n\n<script lang=\"ts\">\n\timport type { Snippet } from 'svelte';\n\timport type { HTMLAttributes } from 'svelte/elements';\n\timport { cn } from '$UTILS$.js';\n\n\tlet {\n\t\tchildren,\n\t\tdirection = 'horizontal',\n\t\tclass: className,\n\t\t...restProps\n\t}: HTMLAttributes<HTMLDivElement> & {\n\t\tchildren: Snippet;\n\t\tdirection?: StatDirection;\n\t} = $props();\n</script>\n\n<div\n\t{...restProps}\n\tdata-slot=\"stats\"\n\tdata-direction={direction}\n\tclass={cn(\n\t\t'grid overflow-x-auto rounded-xl bg-card text-card-foreground',\n\t\t{\n\t\t\t'auto-cols-fr grid-flow-col divide-x divide-border': direction === 'horizontal',\n\t\t\t'grid-flow-row divide-y divide-border': direction === 'vertical',\n\t\t\t'grid-flow-row divide-y divide-border sm:auto-cols-fr sm:grid-flow-col sm:divide-x sm:divide-y-0':\n\t\t\t\tdirection === 'responsive'\n\t\t},\n\t\tclassName\n\t)}\n>\n\t{@render children()}\n</div>\n",
			"type": "registry:ui",
			"target": "stat/stat.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport type { Snippet } from 'svelte';\n\timport type { HTMLAttributes } from 'svelte/elements';\n\timport { cn } from '$UTILS$.js';\n\n\tlet {\n\t\tchildren,\n\t\tclass: className,\n\t\t...restProps\n\t}: HTMLAttributes<HTMLDivElement> & { children: Snippet } = $props();\n</script>\n\n<div\n\t{...restProps}\n\tdata-slot=\"stat\"\n\tclass={cn(\n\t\t'grid min-w-56 grid-cols-[minmax(0,1fr)_auto] grid-rows-[auto_auto_auto] gap-x-4 px-6 py-5',\n\t\tclassName\n\t)}\n>\n\t{@render children()}\n</div>\n",
			"type": "registry:ui",
			"target": "stat/stat-item.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport type { Snippet } from 'svelte';\n\timport type { HTMLAttributes } from 'svelte/elements';\n\timport { cn } from '$UTILS$.js';\n\n\tlet {\n\t\tchildren,\n\t\tclass: className,\n\t\t...restProps\n\t}: HTMLAttributes<HTMLDivElement> & { children: Snippet } = $props();\n</script>\n\n<div\n\t{...restProps}\n\tdata-slot=\"stat-title\"\n\tclass={cn('col-start-1 row-start-1 text-sm text-muted-foreground', className)}\n>\n\t{@render children()}\n</div>\n",
			"type": "registry:ui",
			"target": "stat/stat-title.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport type { Snippet } from 'svelte';\n\timport type { HTMLAttributes } from 'svelte/elements';\n\timport { cn } from '$UTILS$.js';\n\n\tlet {\n\t\tchildren,\n\t\tclass: className,\n\t\t...restProps\n\t}: HTMLAttributes<HTMLDivElement> & { children: Snippet } = $props();\n</script>\n\n<div\n\t{...restProps}\n\tdata-slot=\"stat-value\"\n\tclass={cn('col-start-1 row-start-2 text-3xl font-bold tracking-tight', className)}\n>\n\t{@render children()}\n</div>\n",
			"type": "registry:ui",
